@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/* ==========================================================================
   TW Design Studio — Tema Preto & Verde (SaaS premium, ChatGPT-like)
   Paleta: #0B0F0C / #1A1F1C / #22C55E / #16A34A / #FFFFFF
   ========================================================================== */

@theme inline {
  --font-display: "Space Grotesk", system-ui, sans-serif;
  --font-sans: "Inter", system-ui, sans-serif;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary-glow: var(--primary-glow);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-border: var(--sidebar-border);
}

:root,
html {
  color-scheme: dark;

  --radius: 0.875rem;

  /* Base — preto profundo com leve toque verde */
  --background: oklch(0.16 0.012 155);        /* #0B0F0C */
  --foreground: oklch(0.98 0.005 150);         /* branco */

  --card: oklch(0.21 0.014 155);               /* #1A1F1C */
  --card-foreground: oklch(0.98 0.005 150);

  --popover: oklch(0.20 0.014 155);
  --popover-foreground: oklch(0.98 0.005 150);

  /* Verde principal #22C55E / glow #16A34A */
  --primary: oklch(0.74 0.18 148);
  --primary-foreground: oklch(0.16 0.012 155);
  --primary-glow: oklch(0.66 0.17 148);

  --secondary: oklch(0.25 0.014 155);
  --secondary-foreground: oklch(0.98 0.005 150);

  --muted: oklch(0.23 0.012 155);
  --muted-foreground: oklch(0.72 0.018 150);

  --accent: oklch(0.30 0.06 150);
  --accent-foreground: oklch(0.98 0.005 150);

  --destructive: oklch(0.62 0.22 25);
  --destructive-foreground: oklch(0.99 0 0);

  --success: oklch(0.74 0.18 148);
  --success-foreground: oklch(0.16 0.012 155);

  --warning: oklch(0.80 0.16 75);
  --warning-foreground: oklch(0.16 0.012 155);

  --border: oklch(1 0 0 / 0.07);
  --input: oklch(1 0 0 / 0.09);
  --ring: oklch(0.74 0.18 148);

  --sidebar: oklch(0.13 0.012 155);            /* mais escuro que bg */
  --sidebar-foreground: oklch(0.92 0.008 150);
  --sidebar-border: oklch(1 0 0 / 0.05);

  /* Gradientes & sombras */
  --gradient-primary: linear-gradient(135deg, oklch(0.74 0.18 148), oklch(0.66 0.17 148));
  --gradient-hero: radial-gradient(
      80% 60% at 50% 0%,
      oklch(0.50 0.16 148 / 0.30) 0%,
      transparent 70%
    ),
    linear-gradient(180deg, oklch(0.16 0.012 155) 0%, oklch(0.13 0.012 155) 100%);
  --gradient-card: linear-gradient(160deg, oklch(0.23 0.018 150 / 0.9), oklch(0.18 0.012 155 / 0.75));

  --shadow-glow: 0 0 40px -10px oklch(0.74 0.18 148 / 0.45);
  --shadow-elegant: 0 20px 60px -20px oklch(0.10 0.012 155 / 0.8);
}

@layer base {
  * {
    border-color: var(--color-border);
  }
  html,
  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  /* Toque para mobile: alvos confortáveis */
  button, [role="button"], a {
    -webkit-tap-highlight-color: transparent;
  }
}

@layer utilities {
  .bg-hero { background: var(--gradient-hero); }
  .bg-gradient-primary { background: var(--gradient-primary); }
  .bg-card-glass {
    background: var(--gradient-card);
    backdrop-filter: blur(10px);
  }
  .shadow-glow { box-shadow: var(--shadow-glow); }
  .shadow-elegant { box-shadow: var(--shadow-elegant); }
  .text-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
}

/* Fundo personalizado escolhido pelo cliente: fica atrás da interface
   sem alterar a paleta Auri. */
body[data-custom-theme="image"] {
  background-color: #080808;
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
  background-attachment: fixed;
}

body[data-custom-theme="image"] .bg-background {
  background-color: color-mix(in srgb, var(--background) 48%, transparent) !important;
  background-image: none !important;
}

body[data-custom-theme="image"] .bg-sidebar {
  background-color: color-mix(in srgb, var(--sidebar) 76%, transparent) !important;
}

body[data-custom-theme="image"] .bg-hero {
  background:
    linear-gradient(
      180deg,
      color-mix(in srgb, var(--background) 36%, transparent),
      color-mix(in srgb, var(--background) 54%, transparent)
    ) !important;
}

/* WhatsApp QR: always stays inside the mobile viewport. */
.auri-qr { width: min(100%, 320px); aspect-ratio: 1 / 1; overflow: hidden; }
.auri-qr img { width: 100%; height: 100%; object-fit: contain; display: block; }
