{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axioma",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
